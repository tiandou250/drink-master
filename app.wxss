/* 饮料小当家 · 全局样式
   新粗野主义：6rpx 黑框 / 零模糊硬阴影 / 零圆角 / 高饱和色块 / 超粗字重 */
page {
    background: #ffffff;
    color: #000000;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    font-size: 30rpx;
    line-height: 1.6;
}

view, text, input, button, scroll-view, image {
    box-sizing: border-box;
}

button {
    border-radius: 0;
}

button::after {
    border: none;
    border-radius: 0;
}

/* ---------- 通用块 ---------- */
.nb {
    border: 6rpx solid #000000;
    background: #ffffff;
    box-shadow: 10rpx 10rpx 0 #000000;
}

.nb-title {
    display: inline-block;
    font-size: 26rpx;
    font-weight: 900;
    padding: 8rpx 20rpx;
    background: #000000;
    color: #ffffff;
    border-radius: 0;
}

.nb-tag {
    display: inline-block;
    font-size: 22rpx;
    font-weight: 900;
    padding: 8rpx 20rpx;
    border: 4rpx solid #000000;
    background: #ffffff;
    border-radius: 0;
}

/* ---------- 分层杯（色块堆叠，不用 SVG） ---------- */
.cup {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    border: 6rpx solid #000000;
    border-radius: 12rpx 12rpx 26rpx 26rpx;
}

.cup-inner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column-reverse;
}

.cup-band {
    width: 100%;
}

.cup-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 62%;
    width: 8%;
    background: rgba(255, 255, 255, 0.26);
}

.cup-shine2 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 78%;
    width: 3%;
    background: rgba(255, 255, 255, 0.16);
}

/* ---------- 底部固定操作栏 ---------- */
.nb-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    border-top: 6rpx solid #000000;
    display: flex;
    gap: 20rpx;
    z-index: 20;
}

.nb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 104rpx;
    font-size: 32rpx;
    font-weight: 900;
    border: 6rpx solid #000000;
    background: #ffffff;
    color: #000000;
    box-shadow: 10rpx 10rpx 0 #000000;
    border-radius: 0;
    transition: transform .18s ease, box-shadow .18s ease;
}

.nb-btn-accent {
    background: var(--accent, #FCD34D);
    color: #000000;
}

.nb-btn-dark {
    background: #000000;
    color: #ffffff;
}

.nb-btn:active {
    transform: translate(6rpx, 6rpx);
    box-shadow: 2rpx 2rpx 0 #000000;
}

.nb-btn-disabled {
    opacity: .3;
}

/* ---------- 浮层 ---------- */
.fx-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32rpx;
}

.fx-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, .46);
}

.fx-card {
    position: relative;
    width: 100%;
    background: #ffffff;
    border: 6rpx solid #000000;
    box-shadow: 12rpx 12rpx 0 #000000;
    padding: 40rpx 32rpx 32rpx;
    animation: fx-pop .3s ease both;
}

@keyframes fx-pop {
    0% { opacity: 0; transform: scale(.9) translateY(20rpx); }
    100% { opacity: 1; transform: none; }
}

.fx-close {
    position: absolute;
    top: 12rpx;
    right: 16rpx;
    width: 48rpx;
    height: 48rpx;
    line-height: 42rpx;
    text-align: center;
    font-size: 34rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    background: #ffffff;
}
