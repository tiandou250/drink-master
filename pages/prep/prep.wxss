.page {
    padding-bottom: 40rpx;
}

/* ---------- 头部 ---------- */
.hero {
    display: flex;
    align-items: flex-start;
    margin: 32rpx;
    padding: 32rpx;
    border: 6rpx solid #000000;
    box-shadow: 12rpx 12rpx 0 #000000;
}

.cup-lg {
    width: 190rpx;
    height: 250rpx;
    flex-shrink: 0;
    box-shadow: 10rpx 10rpx 0 #000000;
}

.hero-info {
    flex: 1;
    margin-left: 32rpx;
    min-width: 0;
}

.hero-title {
    font-size: 50rpx;
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 16rpx;
}

.hero-sub {
    font-size: 24rpx;
    line-height: 1.7;
    margin-bottom: 20rpx;
}

.brands {
    display: flex;
    flex-wrap: wrap;
}

.tag {
    margin: 0 12rpx 12rpx 0;
    box-shadow: 4rpx 4rpx 0 #000000;
}

/* ---------- 栏目 ---------- */
.sec {
    margin: 0 32rpx 48rpx;
}

.sec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.sec-note {
    font-size: 24rpx;
    font-weight: 900;
}

/* ---------- 原料 ---------- */
.ing {
    display: flex;
    align-items: flex-start;
    padding: 26rpx 0;
    border-bottom: 4rpx solid #000000;
}

.ing:last-child {
    border-bottom: none;
}

.check {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #000000;
    background: #ffffff;
    flex-shrink: 0;
    margin-top: 4rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ing.done .check {
    background: #000000;
}

.tick {
    color: #ffffff;
    font-size: 26rpx;
    line-height: 1;
}

.ing-main {
    flex: 1;
    margin-left: 24rpx;
    min-width: 0;
}

.ing-name {
    font-size: 30rpx;
    font-weight: 900;
    margin-bottom: 6rpx;
}

.opt {
    font-size: 20rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    padding: 0 10rpx;
    margin-left: 12rpx;
}

.ing-note {
    font-size: 24rpx;
    line-height: 1.6;
    color: #3a3a3a;
}

.ing-amt {
    font-size: 28rpx;
    font-weight: 900;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.ing.done .ing-name,
.ing.done .ing-amt {
    text-decoration: line-through;
    color: #999999;
}

.ing.done .ing-note {
    color: #bbbbbb;
}

/* ---------- 工具 ---------- */
.tools {
    display: flex;
    flex-wrap: wrap;
}

.tool {
    margin: 0 16rpx 16rpx 0;
    padding: 14rpx 28rpx;
    box-shadow: 4rpx 4rpx 0 #000000;
}

/* ---------- 避坑 / 还原度 ---------- */
.pitfall {
    display: flex;
    padding: 26rpx 28rpx;
    margin-bottom: 24rpx;
    border: 6rpx solid #000000;
    border-left-width: 18rpx;
    border-left-color: var(--accent, #FCD34D);
    background: #ffffff;
    box-shadow: 8rpx 8rpx 0 #000000;
}

.pf-num {
    font-size: 22rpx;
    font-weight: 900;
    background: #000000;
    color: #ffffff;
    padding: 0 12rpx;
    height: 40rpx;
    line-height: 40rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.pf-text {
    flex: 1;
    font-size: 26rpx;
    line-height: 1.7;
}

.fidelity {
    padding: 30rpx 34rpx;
    border: 6rpx dashed #000000;
    font-size: 26rpx;
    line-height: 1.75;
}

/* ---------- 底部 ---------- */
.bar-space {
    height: 180rpx;
}

.btn-hover {
    transform: translate(6rpx, 6rpx);
    box-shadow: 2rpx 2rpx 0 #000000;
}

.hint {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 180rpx;
    display: flex;
    justify-content: center;
    z-index: 21;
    pointer-events: none;
}

.hint-tag {
    background: #000000;
    color: #ffffff;
    font-size: 22rpx;
    font-weight: 900;
    padding: 8rpx 26rpx;
}

.nb-empty {
    margin: 120rpx 32rpx;
    padding: 80rpx 40rpx;
    text-align: center;
    font-weight: 900;
    border: 6rpx dashed #000000;
}
