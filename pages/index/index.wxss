.page {
    min-height: 100vh;
    padding-bottom: 60rpx;
}

/* ---------- 顶部 ---------- */
.head {
    padding: 36rpx 32rpx 0;
}

.brand {
    display: inline-block;
    font-size: 38rpx;
    font-weight: 900;
    padding: 12rpx 24rpx;
    background: #000000;
    color: #ffffff;
    margin-bottom: 24rpx;
}

.search {
    display: flex;
    align-items: center;
    height: 96rpx;
    padding: 0 28rpx;
    border: 6rpx solid #000000;
    background: #ffffff;
}

.search-ico {
    font-size: 30rpx;
    margin-right: 16rpx;
    color: #999999;
}

.search-input {
    flex: 1;
    font-size: 30rpx;
    font-weight: 700;
}

.ph {
    color: #999999;
    font-weight: 400;
}

.quick {
    display: flex;
    gap: 16rpx;
    margin-top: 20rpx;
}

.quick-btn {
    flex: 1;
    height: 80rpx;
    font-size: 28rpx;
    font-weight: 900;
    border: 6rpx solid #000000;
    background: #ffffff;
    box-shadow: 6rpx 6rpx 0 #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
}

.quick-dark {
    background: #000000;
    color: #ffffff;
}

.q-emoji {
    font-size: 30rpx;
}

.quick-hover {
    transform: translate(4rpx, 4rpx);
    box-shadow: 2rpx 2rpx 0 #000000;
}

/* ---------- 筛选 ---------- */
.tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    padding: 32rpx 32rpx 8rpx;
}

.tab {
    padding: 12rpx 24rpx;
    font-size: 26rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    background: #ffffff;
}

.tab.on {
    background: #000000;
    color: #ffffff;
}

.filters {
    padding: 12rpx 32rpx 0;
}

.chip {
    display: inline-block;
    font-size: 24rpx;
    font-weight: 900;
    padding: 10rpx 24rpx;
    border: 4rpx dashed #000000;
    background: #ffffff;
}

.chip.on {
    background: #000000;
    color: #ffffff;
    border-style: solid;
}

/* ---------- 卡片 ---------- */
.cards {
    padding: 26rpx 32rpx 44rpx;
    display: flex;
    flex-direction: column;
    gap: 22rpx;
}

.card {
    display: flex;
    align-items: center;
    gap: 24rpx;
    padding: 24rpx;
    border: 6rpx solid #000000;
    box-shadow: 10rpx 10rpx 0 #000000;
    animation: card-in .36s ease both;
}

@keyframes card-in {
    from { opacity: 0; transform: translateY(20rpx); }
    to { opacity: 1; transform: none; }
}

.card-hover {
    transform: translate(4rpx, 4rpx);
    box-shadow: 2rpx 2rpx 0 #000000;
}

.cup-sm {
    width: 90rpx;
    height: 112rpx;
    flex-shrink: 0;
}

.card-body {
    flex: 1;
    min-width: 0;
}

.card-title {
    font-size: 34rpx;
    font-weight: 900;
    line-height: 1.25;
    margin-bottom: 8rpx;
}

.nb-nocaf {
    font-size: 20rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    background: #ffffff;
    padding: 2rpx 10rpx;
    margin-left: 10rpx;
}

.card-meta {
    font-size: 22rpx;
    font-weight: 700;
}

.empty {
    padding: 70rpx 20rpx;
    text-align: center;
    font-weight: 900;
    border: 6rpx dashed #000000;
}

.empty-sub {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    font-weight: 400;
}

.end {
    text-align: center;
    font-size: 22rpx;
    color: #999999;
    padding: 16rpx 0 40rpx;
}

/* ---------- 抽一杯 ---------- */
.picker {
    text-align: center;
    padding-top: 44rpx;
}

.kicker {
    font-size: 22rpx;
    font-weight: 900;
    letter-spacing: .1em;
    color: #777777;
    margin-bottom: 26rpx;
}

.kicker text {
    font-size: 30rpx;
    margin-left: 8rpx;
}

.pick-cup {
    width: 200rpx;
    height: 264rpx;
    margin: 0 auto 26rpx;
    box-shadow: 8rpx 8rpx 0 #000000;
}

.pick-name {
    font-size: 46rpx;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 12rpx;
}

.pick-meta {
    font-size: 22rpx;
    font-weight: 700;
    color: #444444;
    margin-bottom: 24rpx;
}

.pick-line {
    display: inline-block;
    font-size: 26rpx;
    font-weight: 900;
    padding: 10rpx 24rpx;
    background: #FCD34D;
    border: 4rpx solid #000000;
    transform: rotate(-1deg);
    margin-bottom: 32rpx;
}

.pick-actions {
    display: flex;
    gap: 16rpx;
}

.btn-hover {
    transform: translate(6rpx, 6rpx);
    box-shadow: 2rpx 2rpx 0 #000000;
}

/* ---------- 手边有什么 ---------- */
.sheet-overlay {
    align-items: flex-end;
    padding: 0;
}

.sheet {
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    padding: 32rpx 28rpx 24rpx;
    box-shadow: none;
    border-bottom: none;
    border-left: none;
    border-right: none;
}

.sheet-title {
    font-size: 40rpx;
    font-weight: 900;
    line-height: 1.2;
}

.sheet-sub {
    font-size: 24rpx;
    font-weight: 700;
    color: #555555;
    margin: 6rpx 0 22rpx;
}

.pantry-bar {
    display: flex;
    gap: 12rpx;
    margin-bottom: 16rpx;
}

.pantry-input {
    flex: 1;
    height: 76rpx;
    padding: 0 18rpx;
    border: 4rpx solid #000000;
    background: #ffffff;
    font-size: 26rpx;
    font-weight: 700;
}

.pantry-clear {
    width: 120rpx;
    height: 76rpx;
    line-height: 68rpx;
    text-align: center;
    font-size: 24rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    background: #ffffff;
    box-shadow: 4rpx 4rpx 0 #000000;
}

.chips {
    height: 190rpx;
    flex-shrink: 0;
}

.chip-item {
    display: inline-block;
    font-size: 22rpx;
    font-weight: 900;
    padding: 8rpx 18rpx;
    border: 4rpx solid #000000;
    background: #ffffff;
    box-shadow: 3rpx 3rpx 0 #000000;
    margin: 0 12rpx 12rpx 0;
}

.chip-item.on {
    background: #000000;
    color: #ffffff;
    box-shadow: none;
}

.chip-item.sug {
    background: #FCD34D;
    color: #000000;
}

.chip-n {
    opacity: .55;
    margin-left: 8rpx;
    font-weight: 700;
}

.chips-empty {
    font-size: 24rpx;
    color: #888888;
    padding: 20rpx 0;
}

.chips-note {
    font-size: 20rpx;
    font-weight: 700;
    color: #888888;
    margin: 4rpx 0 20rpx;
}

.results {
    height: 540rpx;
    flex-shrink: 0;
}

.group {
    margin-bottom: 28rpx;
}

.group-title {
    display: flex;
    align-items: center;
    gap: 12rpx;
    font-size: 28rpx;
    font-weight: 900;
    margin-bottom: 16rpx;
}

.cnt {
    font-size: 20rpx;
    font-weight: 900;
    padding: 2rpx 14rpx;
    background: #000000;
    color: #ffffff;
}

.cnt-one {
    background: #F59E0B;
    color: #000000;
}

.group-empty {
    font-size: 24rpx;
    font-weight: 700;
    color: #666666;
    padding: 22rpx;
    border: 4rpx dashed #000000;
    text-align: center;
}

.suggest {
    display: flex;
    flex-wrap: wrap;
    margin-top: 16rpx;
}

.mini {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 14rpx 16rpx;
    margin-bottom: 14rpx;
    border: 4rpx solid #000000;
    box-shadow: 5rpx 5rpx 0 #000000;
}

.mini-cup {
    width: 54rpx;
    height: 70rpx;
    flex-shrink: 0;
    border-width: 4rpx;
}

.mini-body {
    flex: 1;
    min-width: 0;
}

.mini-name {
    font-size: 26rpx;
    font-weight: 900;
    line-height: 1.25;
}

.mini-meta {
    font-size: 20rpx;
    font-weight: 700;
    color: #444444;
}

.mini-miss {
    flex-shrink: 0;
    font-size: 20rpx;
    font-weight: 900;
    padding: 4rpx 12rpx;
    background: #ffffff;
    border: 4rpx solid #000000;
}

.more {
    font-size: 22rpx;
    font-weight: 700;
    color: #777777;
    padding: 10rpx 0;
}
